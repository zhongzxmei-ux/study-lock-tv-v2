<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="学习锁 · 家长控制台"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="题库加载中 · v1.0 电视版"
                android:textColor="#BFD9FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 顶部主开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学习锁守护"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvGuardSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="守护已关闭 · 点击右侧按钮开启"
                    android:textColor="#B8D4FA"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleGuard"
                android:layout_width="160dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_option_button"
                android:focusable="true"
                android:text="开启守护"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 状态卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvStatusHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="守护未开启"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="每轮 15 分钟 · 每次 2 题 · 答错等待 60 秒"
                android:textColor="#BFD9FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 每轮观看时长 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每轮观看时长"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnDur15" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="15 分钟" />
                <Button android:id="@+id/btnDur20" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="20 分钟" />
                <Button android:id="@+id/btnDur30" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="30 分钟" />
                <Button android:id="@+id/btnDur45" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="45 分钟" />
                <Button android:id="@+id/btnDur60" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginEnd="18dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="60 分钟" />
                <Button android:id="@+id/btnDurMinus" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_option_button" android:focusable="true" android:text="-" />
                <TextView android:id="@+id/tvCustomDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="14dp" android:text="15 分钟" android:textSize="16sp" />
                <Button android:id="@+id/btnDurPlus" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_option_button" android:focusable="true" android:text="+" />
            </LinearLayout>
        </LinearLayout>

        <!-- 每次弹窗答题数量 & 答错等待 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每次弹窗答题数量 / 答错讲解等待"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnQ1" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="1 道" />
                <Button android:id="@+id/btnQ2" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="2 道" />
                <Button android:id="@+id/btnQ3" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="3 道" />
                <Button android:id="@+id/btnQ5" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="5 道" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnWait30" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="30 秒" />
                <Button android:id="@+id/btnWait60" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="60 秒" />
                <Button android:id="@+id/btnWait90" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="90 秒" />
                <Button android:id="@+id/btnWait120" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="18dp" android:text="120 秒" />
            </LinearLayout>
        </LinearLayout>

        <!-- 答对鼓励 & 应用伪装 & 操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="答对鼓励 / 应用伪装 / 快捷操作"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnPraiseOff" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="关闭鼓励" />
                <Button android:id="@+id/btnPraiseSfx" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="音效(推荐)" />
                <Button android:id="@+id/btnPraiseVoice" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="音效+语音夸奖" />
                <Button android:id="@+id/btnTestPraise" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="试听鼓励" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnAliasDefault" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="学习锁(原名)" />
                <Button android:id="@+id/btnAliasSettings" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="伪装:系统设置" />
                <Button android:id="@+id/btnAliasBattery" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="伪装:电池与性能" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnTestQuizNow" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="20dp" android:text="立即测试弹题" />
                <Button android:id="@+id/btnResetTimer" android:layout_width="wrap_content" android:layout_height="46dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="20dp" android:text="重置计时" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
